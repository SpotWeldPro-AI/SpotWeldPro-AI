# Demo-environment build variables.
# Copy this file to .env.demo and run: vite build --mode demo
# Or set VITE_DEMO_MODE=true as a Render build environment variable.
#
# VITE_DEMO_MODE=true activates:
#   - Username pre-fill:  demo
#   - Password pre-fill:  A1234  (public demo credentials — not a security boundary)
#   - Demo banner on the login page
#   - "Start / Sign In" button label
#
# The backend demo account must be provisioned separately via DEMO_USERNAME and
# DEMO_PASSWORD environment variables on the server (see backend/.env.demo.example).
# Demo credentials are intentionally public; use an isolated demo database.

VITE_DEMO_MODE=true
