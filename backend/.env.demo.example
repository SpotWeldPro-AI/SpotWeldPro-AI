# Backend demo-environment variables.
# Set these in the Render dashboard (or copy to .env for local demo testing).
# These are only read when HOSTED_DEMO=true is also set.
#
# Never use a production database with these settings.
# The demo account is READ_ONLY and isolated to the demo database.

DATABASE_URL=postgresql://user:password@host/spotweldpro_demo
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-hosting
CORS_ORIGINS=https://spotweldpro-ai-demo.onrender.com
HOSTED_DEMO=true
DISABLE_DOCS=true

# Admin bootstrap
ADMIN_EMAIL=admin@spotwelding.example
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Demo account (READ_ONLY role, public credentials)
DEMO_USERNAME=demo
DEMO_PASSWORD=A1234
